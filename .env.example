# ==============================================================================
# ONIZOUKA SHOP - Modele de Configuration Environnement (.env)
# Copiez ce fichier sous le nom '.env' et ajustez les valeurs selon votre serveur.
# ==============================================================================

# Sécurité & Environnement
SECRET_KEY=cle-secrete-django-tres-longue-et-aleatoire-a-generer-pour-la-production
DEBUG=False
ALLOWED_HOSTS=onizoukashop.com,www.onizoukashop.com,127.0.0.1,localhost

# Base de Données
# En local / développement : SQLite
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# En production (PostgreSQL recommandé) :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=onizouka_prod_db
# DB_USER=onizouka_user
# DB_PASSWORD=mot_de_passe_robuste_bdd
# DB_HOST=localhost
# DB_PORT=5432

# Coordonnées officielles de l'entreprise
STORE_NAME="ONIZOUKA SHOP"
STORE_PHONE="+22392673799"
STORE_WHATSAPP="+22392673799"
STORE_ADDRESS="Grand Marché de Bamako, Dabanani, Bamako, Mali"

# Configuration des Emails Transactionnels
# En développement : affichage direct dans la console terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# En production (Configuration SMTP ultérieure selon votre fournisseur) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.votrefournisseur.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=contact@onizoukashop.com
# EMAIL_HOST_PASSWORD=mot_de_passe_email_ou_app
# DEFAULT_FROM_EMAIL=Onizouka Shop <commandes@onizoukashop.com>
# SERVER_EMAIL=alertes@onizoukashop.com
